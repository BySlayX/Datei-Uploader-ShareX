# Datenbank: sqlite für die interne Datenbank oder mysql für MySQL/MariaDB
DATABASE_TYPE=sqlite
SQLITE_PATH=sharex.db

# Nur bei DATABASE_TYPE=mysql benötigt:
MYSQL_HOST=db.example.com
MYSQL_PORT=3306
MYSQL_DATABASE=sharex
MYSQL_USER=sharex_uploader
MYSQL_PASSWORD=change-me-db-password
MYSQL_TLS=true

# Optional: komplette Verbindung angeben; überschreibt die MYSQL_* Einzelwerte
# MYSQL_DSN=sharex_uploader:passwort@tcp(db.example.com:3306)/sharex?parseTime=true&charset=utf8mb4&loc=UTC&tls=true

# Öffentliche HTTPS-Adresse. Der Linux-Installer fragt diese Werte ab.
PUBLIC_HOST=files.example.com
TLS_EMAIL=admin@example.com
BASE_URL=https://files.example.com
PORT=8080
# Hinter dem HTTPS-Reverse-Proxy immer true verwenden.
COOKIE_SECURE=true
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password
# Optional: leer lassen, damit die Web-Einrichtung sichere Schlüssel erzeugt.
UPLOAD_API_KEY=
ADMIN_API_KEY=
# Optional: Pepper für API-Key-Hashes. Leer lassen = bisheriges Verhalten.
# Wenn gesetzt, danach Upload-/Admin-Keys neu generieren.
# API_KEY_PEPPER=
CORS_ORIGIN=
MAX_UPLOAD_MB=100
MAX_STORAGE_MB=5120

# Optional: SMTP für Passwort-Reset und Sicherheitswarnungen bei neuen IP-Adressen
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=mailer@example.com
SMTP_PASSWORD=change-me-smtp-password
SMTP_FROM=admin@example.com
SMTP_TLS=true
